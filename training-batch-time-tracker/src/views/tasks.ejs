<nav class="breadcrumb"><a href="/projects">Projects</a> → <%= project.name %></nav>
<h1><%= project.name %></h1>
<p class="page-lead">Tasks in this project.</p>
<div class="form-section">
  <p class="form-section-title">New task</p>
  <form method="post" action="/projects/<%= project.id %>/tasks" class="form-inline">
    <label for="name">Name</label>
    <input type="text" id="name" name="name" placeholder="Task name" required>
    <button type="submit">Add task</button>
  </form>
</div>
<% if (tasks.length) { %>
  <div class="table-wrap">
  <table class="table">
    <thead>
      <tr><th>Task</th></tr>
    </thead>
    <tbody>
      <% tasks.forEach(t => { %>
        <tr><td><%= t.name %></td></tr>
      <% }); %>
    </tbody>
  </table>
  </div>
<% } else { %>
  <p class="empty-state">No tasks yet. Add one above.</p>
<% } %>
